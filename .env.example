# AuraView environment variables — copy to `.env` and fill in real values.
# DO NOT commit `.env` to Git.

# 공공데이터포털 인증키 (디코딩키)
SERVICE_KEY=replace-me

# 교통안전 실시간 신호등 정보 API base
BASE_URL=https://apis.data.go.kr/B551982/rti

# 한국도로공사 공공데이터 — VDS(실시간 소통), 돌발상황
EX_OPEN_BASE_URL=https://data.ex.co.kr/openapi
EX_OPEN_KEY=replace-me

# TAAS 교통사고분석시스템 (교통안전공단)
TAAS_BASE_URL=https://taas.koroad.or.kr/openapi
TAAS_KEY=replace-me

# ITS 국가교통정보센터
ITS_BASE_URL=https://openapi.its.go.kr:9443
ITS_KEY=replace-me

# 국토교통 데이터안심구역 분석 결과물 반출 해시 검증
DSZ_VERIFY_HASH=replace-me

# Fleet Learning 기여 업로드 서명 검증 키 (HMAC)
FLEET_HMAC_SECRET=replace-me
