<?xml version="1.0" encoding="utf-8"?>
<!-- AuraView splash — dark navy + cyan radial + AuraView logo center -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 배경 그라디언트 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600"
                android:centerX="0.5"
                android:centerY="0.45"
                android:startColor="#003E5C"
                android:endColor="#080C14" />
        </shape>
    </item>
    <!-- 중앙 AuraView 로고 (mipmap ic_launcher_foreground) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
